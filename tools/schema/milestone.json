{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "milestone",
  "type": "object",
  "required": ["id", "type", "title", "status", "summary"],
  "properties": {
    "id": { "type": "string", "pattern": "^MIL-[0-9]+$" },
    "type": { "const": "milestone" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "proposed", "accepted", "deprecated"] },
    "summary": { "type": "string", "minLength": 1 },
    "due": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "stage": false,
    "progress": false,
    "tags": { "type": "array", "items": { "type": "string" } },
    "links": { "type": "array", "items": { "type": "string" } },
    "topic": { "type": "string", "pattern": "^TOP-[0-9]+$" },
    "created": { "type": "string" },
    "updated": { "type": "string" },
    "superseded_by": { "type": ["string", "null"] }
  }
}
