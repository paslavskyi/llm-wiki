{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEC-[0-9]+$"
    },
    "type": {
      "const": "decision"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "deprecated"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topic": {
      "type": "string",
      "pattern": "^TOP-[0-9]+$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "object"
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "verify": {
            "type": "string"
          }
        }
      }
    },
    "decided": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "deciders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consulted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "informed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revisit": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
