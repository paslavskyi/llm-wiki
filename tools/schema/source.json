{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "summary",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SRC-[0-9]+$"
    },
    "type": {
      "const": "source"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "deprecated"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "interview",
        "conversation",
        "document",
        "url",
        "research",
        "survey",
        "analytics",
        "observation"
      ]
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topic": {
      "type": "string",
      "pattern": "^TOP-[0-9]+$"
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
