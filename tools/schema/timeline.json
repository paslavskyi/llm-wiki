{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "timeline",
  "type": "object",
  "required": ["id", "type", "title", "status", "summary", "sequence"],
  "properties": {
    "id": { "type": "string", "pattern": "^TL-[0-9]+$" },
    "type": { "const": "timeline" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "proposed", "accepted", "deprecated"] },
    "summary": { "type": "string", "minLength": 1 },
    "sequence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^MIL-[0-9]+$" }
    },
    "now": false,
    "statuses": false,
    "tags": { "type": "array", "items": { "type": "string" } },
    "links": { "type": "array", "items": { "type": "string" } },
    "topic": { "type": "string", "pattern": "^TOP-[0-9]+$" },
    "created": { "type": "string" },
    "updated": { "type": "string" },
    "superseded_by": { "type": ["string", "null"] }
  }
}
